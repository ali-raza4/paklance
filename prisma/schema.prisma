generator client {
binaryTargets = ["native", "rhel-openssl-3.0.x"]
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String              @id @default(uuid())
  email                          String              @unique
  name                           String?
  passwordHash                   String
  role                           Role
  createdAt                      DateTime            @default(now())
  updatedAt                      DateTime            @updatedAt
  isEmailVerified                Boolean             @default(false)
  emailVerifyOtp                 String?
  emailVerifyExpires             DateTime?
  emailVerifyLastSentAt         DateTime?
  availability                   Availability        @default(AVAILABLE)
  avatarUrl                      String?
  bio                            String?
  city                           String?
  country                        String?
  headline                       String?
  hourlyRate                     Decimal?
  skills                         String[]
  contractsAsClient              Contract[]          @relation("ClientContracts")
  contractsAsSpecialist          Contract[]          @relation("SpecialistContracts")
  disputesRaised                 Dispute[]           @relation("UserDisputes")
  escrows                        Escrow[]            @relation("UserEscrows")
  jobs                           Job[]
  portfolioItems                 PortfolioItem[]
  Proposal                       Proposal[]
  Review_Review_revieweeIdToUser Review[]            @relation("Review_revieweeIdToUser")
  Review_Review_reviewerIdToUser Review[]            @relation("Review_reviewerIdToUser")
  verification                   Verification?
  wallets                        Wallet[]
  payments                       Payment[]
  payoutMethods                  PayoutMethod[]
  withdrawalRequests             WithdrawalRequest[]
  uploadedContractFiles          ContractFile[]      @relation("UserUploadedContractFiles")
}

model Verification {
  id          String             @id @default(uuid())
  userId      String             @unique
  documentUrl String
  status      VerificationStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id])
}

model Job {
  id          String     @id @default(uuid())
  title       String
  description String
  budget      Decimal
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  clientId    String
  contracts   Contract[]
  client      User       @relation(fields: [clientId], references: [id])
  Proposal    Proposal[]
}

model Contract {
  id           String         @id @default(uuid())
  jobId        String
  clientId     String
  specialistId String
  status       ContractStatus @default(DRAFT)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  client       User           @relation("ClientContracts", fields: [clientId], references: [id])
  job          Job            @relation(fields: [jobId], references: [id])
  specialist   User           @relation("SpecialistContracts", fields: [specialistId], references: [id])
  disputes     Dispute[]
  escrow       Escrow?
  milestones   Milestone[]
  Review       Review[]
  payments     Payment[]
  files        ContractFile[]
}

model ContractFile {
  id           String   @id @default(uuid())
  contractId   String
  uploaderId   String
  filename     String
  originalName String
  fileSize     Int
  mimeType     String
  fileData     String   // base64 encoded data URI or URL
  createdAt    DateTime @default(now())
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploader     User     @relation("UserUploadedContractFiles", fields: [uploaderId], references: [id])
}

model Milestone {
  id          String          @id @default(uuid())
  contractId  String
  title       String
  description String
  amount      Decimal
  dueDate     DateTime?
  status      MilestoneStatus @default(PENDING)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  contract    Contract        @relation(fields: [contractId], references: [id])
}

model Escrow {
  id            String        @id @default(uuid())
  contractId    String        @unique
  balance       Decimal       @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        String
  contract      Contract      @relation(fields: [contractId], references: [id])
  user          User          @relation("UserEscrows", fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]
}

model LedgerEntry {
  id                  String       @id @default(uuid())
  escrowId            String
  sourceWalletId      String
  destinationWalletId String
  amount              Decimal
  status              LedgerStatus @default(PENDING)
  createdAt           DateTime     @default(now())
  escrow              Escrow       @relation(fields: [escrowId], references: [id])
}

model Dispute {
  id               String        @id @default(uuid())
  contractId       String
  raisedByUserId   String
  reason           String
  status           DisputeStatus @default(OPEN)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  resolution       String?
  resolvedByUserId String?
  contract         Contract      @relation(fields: [contractId], references: [id])
  raisedByUser     User          @relation("UserDisputes", fields: [raisedByUserId], references: [id])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String
  balance      Decimal             @default(0)
  lockedBalance Decimal            @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]
}

model WalletTransaction {
  id        String   @id @default(uuid())
  walletId  String
  amount    Decimal
  type      String
  createdAt DateTime @default(now())
  wallet    Wallet   @relation(fields: [walletId], references: [id])
}

model Payment {
  id              String          @id @default(uuid())
  contractId      String?
  userId          String
  amount          Decimal
  currency        String          @default("PKR")
  provider        PaymentProvider
  status          PaymentStatus   @default(PENDING)
  referenceId     String          @unique
  gatewayTxnId    String?
  gatewayResponse Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contract        Contract?       @relation(fields: [contractId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
}

model PaymentWebhookLog {
  id             String          @id @default(uuid())
  provider       PaymentProvider
  eventType      String?
  referenceId    String?
  payload        Json
  headers        Json?
  signatureValid Boolean
  processed      Boolean         @default(false)
  error          String?
  createdAt      DateTime        @default(now())
}

model PayoutMethod {
  id            String              @id @default(uuid())
  userId        String
  type          PayoutType
  accountTitle  String
  accountNumber String
  bankName      String?
  isDefault     Boolean             @default(false)
  isVerified    Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id])
  withdrawals   WithdrawalRequest[]
}

model WithdrawalRequest {
  id                   String           @id @default(uuid())
  userId               String
  walletId             String
  payoutMethodId       String?
  amount               Decimal
  fee                  Decimal          @default(0)
  netAmount            Decimal
  status               WithdrawalStatus @default(REQUESTED)
  referenceId          String           @unique
  payoutMethodSnapshot Json
  adminNote            String?
  failureReason        String?
  processedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id])
  wallet               Wallet           @relation(fields: [walletId], references: [id])
  payoutMethod         PayoutMethod?    @relation(fields: [payoutMethodId], references: [id])
}

model PortfolioItem {
  id          String   @id @default(uuid())
  userId      String
  kind        String   @default("portfolio")
  title       String
  subtitle    String?
  url         String?
  amount      Decimal?
  startYear   Int?
  endYear     Int?
  description String?
  imageUrl    String?
  projectUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

model Conversation {
  id             String    @id @default(uuid())
  participant1Id String
  participant2Id String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  Message        Message[]
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isDelivered    Boolean      @default(false)
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Proposal {
  id           String         @id @default(uuid())
  jobId        String
  freelancerId String
  coverLetter  String
  bidAmount    Decimal
  deliveryDays Int
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  User         User           @relation(fields: [freelancerId], references: [id])
  job          Job            @relation(fields: [jobId], references: [id])
}

model Review {
  id                           String   @id @default(uuid())
  contractId                   String
  reviewerId                   String
  revieweeId                   String
  rating                       Int
  comment                      String?
  createdAt                    DateTime @default(now())
  Contract                     Contract @relation(fields: [contractId], references: [id])
  User_Review_revieweeIdToUser User     @relation("Review_revieweeIdToUser", fields: [revieweeId], references: [id])
  User_Review_reviewerIdToUser User     @relation("Review_reviewerIdToUser", fields: [reviewerId], references: [id])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum Availability {
  AVAILABLE
  BUSY
  NOT_AVAILABLE
}

enum Role {
  ADMIN
  CLIENT
  SPECIALIST
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractStatus {
  DRAFT
  FUNDED
  IN_PROGRESS
  COMPLETED
  DISPUTED
  CLOSED
}

enum MilestoneStatus {
  PENDING
  FUNDED
  RELEASED
  DISPUTED
}

enum LedgerStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum PaymentProvider {
  JAZZCASH
  EASYPAISA
  RAAST
  BANK_TRANSFER
  SANDBOX
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  TIMEOUT
  MISMATCHED
}

enum PayoutType {
  BANK
  JAZZCASH
  EASYPAISA
  RAAST
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

