{
  "version": 2,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://paklance-backend-updated.vercel.app/api/:path*"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
